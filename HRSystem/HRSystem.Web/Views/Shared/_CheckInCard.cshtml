@model TodayAttendanceDto
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="page-card d-flex flex-wrap align-items-center gap-3 mb-4">
    <div class="stat-icon bg-primary-subtle text-primary rounded p-3"><i class="bi bi-fingerprint fs-4"></i></div>
    <div class="flex-grow-1">
        <div class="fw-bold">حضور النهارده @Model.Date.ToString("yyyy-MM-dd")</div>
        <div class="text-muted small">
            @if (Model.ShiftName is not null)
            {
                <span>@Model.ShiftName من @Labels.Time(Model.ShiftStart) لـ @Labels.Time(Model.ShiftEnd)</span>
            }
            @if (!Model.IsWorkingDay) { <span class="badge text-bg-secondary ms-1">إجازة / عطلة</span> }
        </div>
        <div class="small mt-1">
            حضور: <strong>@Labels.Time(Model.CheckIn)</strong>
            · انصراف: <strong>@Labels.Time(Model.CheckOut)</strong>
            @if (Model.LateMinutes > 0) { <span class="text-danger">· متأخر @Model.LateMinutes دقيقة</span> }
        </div>
        @if (Model.RequireSelfie && Model.CheckOut is null)
        {
            <div class="small text-muted mt-1"><i class="bi bi-camera"></i> الكاميرا الأمامية هتفتح تاخد صورة سيلفي مع التسجيل</div>
        }
    </div>
    @if (Model.CheckIn is null)
    {
        <form asp-controller="Attendance" asp-action="CheckIn" method="post" enctype="multipart/form-data" data-geo data-selfie="@(Model.RequireSelfie ? "1" : null)">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <partial name="_GeoFields" />
            @if (Model.RequireSelfie)
            {
                <input type="file" name="selfie" accept="image/*" capture="user" class="d-none" aria-label="صورة سيلفي" />
            }
            <button type="submit" class="btn btn-success"><i class="bi bi-box-arrow-in-left"></i> تسجيل حضور</button>
        </form>
    }
    else if (Model.CheckOut is null)
    {
        <form asp-controller="Attendance" asp-action="CheckOut" method="post" enctype="multipart/form-data" data-geo data-selfie="@(Model.RequireSelfie ? "1" : null)">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <partial name="_GeoFields" />
            @if (Model.RequireSelfie)
            {
                <input type="file" name="selfie" accept="image/*" capture="user" class="d-none" aria-label="صورة سيلفي" />
            }
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right"></i> تسجيل انصراف</button>
        </form>
    }
    else
    {
        <span class="badge text-bg-success p-2">اتسجل حضورك وانصرافك</span>
    }
</div>
