@model LeaveRequestFormViewModel
@{
    ViewData["Title"] = "طلب إجازة";
}

<partial name="_BalanceCards" model="Model.Balances" />

<div class="page-card" style="max-width: 720px">
    <form method="post" enctype="multipart/form-data" id="leaveForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="mb-3">
            <label asp-for="LeaveTypeId" class="form-label"></label>
            <select asp-for="LeaveTypeId" asp-items="Model.LeaveTypes" class="form-select">
                <option value="">— اختار —</option>
            </select>
            <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>

        <div id="preview" class="alert alert-light border d-none mb-3"></div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <textarea asp-for="Reason" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>

        <div class="mb-4" id="attachmentGroup">
            <label asp-for="Attachment" class="form-label"></label>
            <input asp-for="Attachment" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control" />
            <div class="form-text" id="attachmentHint">اختياري. PDF أو صورة، أقصى حجم 5 ميجا.</div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> إرسال الطلب</button>
        <a asp-action="Mine" class="btn btn-light">إلغاء</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live preview: working days and remaining balance before sending
        const fields = ['LeaveTypeId', 'StartDate', 'EndDate'].map(id => document.getElementById(id));
        const box = document.getElementById('preview');

        async function refresh() {
            const [type, start, end] = fields.map(f => f.value);
            if (!type || !start || !end) { box.classList.add('d-none'); return; }

            const url = '@Url.Action("Preview")' + `?leaveTypeId=${type}&start=${start}&end=${end}`;
            const p = await (await fetch(url)).json();

            box.classList.remove('d-none', 'alert-light', 'alert-danger', 'alert-warning');
            document.getElementById('attachmentHint').textContent = p.requiresAttachment
                ? 'مطلوب لنوع الإجازة ده. PDF أو صورة، أقصى حجم 5 ميجا.'
                : 'اختياري. PDF أو صورة، أقصى حجم 5 ميجا.';

            if (p.error) {
                box.classList.add('alert-danger');
                box.textContent = p.error;
            } else if (p.days === 0) {
                box.classList.add('alert-warning');
                box.textContent = 'الفترة دي كلها إجازات أسبوعية أو عطلات رسمية.';
            } else if (p.isLimited && p.days > p.available) {
                box.classList.add('alert-danger');
                box.textContent = `${p.days} يوم عمل، ورصيدك المتاح ${p.available} يوم بس.`;
            } else {
                box.classList.add('alert-light');
                box.textContent = p.isLimited
                    ? `${p.days} يوم عمل. هيفضل في رصيدك ${p.available - p.days} يوم بعد الموافقة.`
                    : `${p.days} يوم عمل.`;
            }
        }

        fields.forEach(f => f.addEventListener('change', refresh));
        refresh();
    </script>
}
