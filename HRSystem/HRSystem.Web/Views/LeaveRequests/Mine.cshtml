@model MyLeavesViewModel
@{
    ViewData["Title"] = "إجازاتي";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h6 fw-bold text-muted mb-0">رصيد @DateTime.Today.Year</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> طلب إجازة</a>
</div>

<partial name="_BalanceCards" model="Model.Balances" />

<div class="page-card">
    <h2 class="h6 fw-bold mb-3">طلباتي</h2>
    <partial name="_RequestsTable" model="(Model.Requests, false)" />
</div>
