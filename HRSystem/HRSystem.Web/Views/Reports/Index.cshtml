@model List<PayrollRunDto>
@{
    ViewData["Title"] = "التقارير";
    var year = DateTime.Today.Year;
    var month = DateTime.Today.Month;
}

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="page-card h-100">
            <h2 class="h6 fw-bold"><i class="bi bi-person-badge text-primary"></i> بيان الموظفين</h2>
            <p class="small text-muted">كل الموظفين ببياناتهم الأساسية. تقدر تفلتر من شاشة الموظفين قبل التصدير.</p>
            <a asp-controller="Employees" asp-action="Export" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="page-card h-100">
            <h2 class="h6 fw-bold"><i class="bi bi-calendar2-range text-primary"></i> أرصدة الإجازات</h2>
            <p class="small text-muted">رصيد كل موظف من كل نوع: المستحق والمستخدم والمعلق والمتاح.</p>
            <a asp-action="LeaveBalances" asp-route-year="@year" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel @year</a>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="page-card h-100">
            <h2 class="h6 fw-bold"><i class="bi bi-clock-history text-primary"></i> الحضور الشهري</h2>
            <p class="small text-muted">حضور وغياب وإجازات وتأخير وأوفر تايم لكل موظف في الشهر.</p>
            <a asp-controller="Attendance" asp-action="Monthly" class="btn btn-sm btn-outline-primary">فتح</a>
            <a asp-controller="Attendance" asp-action="ExportMonthly" asp-route-year="@year" asp-route-month="@month" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> @Labels.Month(month)</a>
        </div>
    </div>
</div>

<div class="page-card mt-4">
    <h2 class="h6 fw-bold mb-3"><i class="bi bi-cash-stack text-primary"></i> المرتبات</h2>
    @if (Model.Count == 0)
    {
        <div class="text-muted">لسه مفيش مسيرات</div>
    }
    else
    {
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>الشهر</th><th>الحالة</th><th>الصافي</th><th class="text-end">تصدير</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@Labels.Month(r.Year, r.Month)</td>
                        <td>@Labels.Of(r.Status)</td>
                        <td>@Labels.Money(r.TotalNet)</td>
                        <td class="text-end">
                            <a asp-controller="Payroll" asp-action="Register" asp-route-id="@r.Id" class="btn btn-sm btn-outline-success">المسير</a>
                            <a asp-controller="Payroll" asp-action="BankFile" asp-route-id="@r.Id" class="btn btn-sm btn-outline-success">ملف البنك</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
