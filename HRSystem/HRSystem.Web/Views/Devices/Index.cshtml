@model List<HRSystem.BLL.Services.DeviceDto>
@{
    ViewData["Title"] = "أجهزة البصمة";
    var site = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<div class="page-card mb-4">
    <div class="page-toolbar">
        <span class="text-muted">أجهزة ZKTeco بتتقرا عن طريق الـ IP (بورت 4370). أول بصمة في اليوم = حضور، وآخر بصمة = انصراف.</span>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> جهاز جديد</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-fingerprint"></i> لسه مفيش أجهزة</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>الجهاز</th><th>العنوان</th><th>طريقة القراية</th><th>آخر قراية</th><th class="text-end">إجراءات</th></tr></thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@d.Name @if (!d.IsEnabled) { <span class="badge text-bg-secondary">موقوف</span> }</td>
                            <td dir="ltr" class="text-end small">@d.IpAddress:@d.Port</td>
                            <td class="small">
                                @if (d.PulledByServer) { <span><i class="bi bi-hdd-network"></i> السيرفر بيقراه كل 10 دقايق</span> }
                                else { <span><i class="bi bi-pc-display"></i> البرنامج اللي في الشركة بيبعت</span> }
                            </td>
                            <td class="small">
                                @if (d.LastSyncAt is DateTime at)
                                {
                                    <span class="badge @(d.LastSyncSucceeded == true ? "text-bg-success" : "text-bg-danger")">@(d.LastSyncSucceeded == true ? "تمام" : "فشل")</span>
                                    <span class="text-muted">@Labels.Ago(at)</span>
                                    <div class="text-muted">@d.LastSyncMessage</div>
                                }
                                else { <span class="text-muted">لسه ماتقراش</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (d.PulledByServer && d.IsEnabled)
                                {
                                    <form asp-action="Pull" asp-route-id="@d.Id" method="post" class="d-inline" data-busy="بنقرا الجهاز...">
                                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-arrow-repeat"></i> اقرا دلوقتي</button>
                                    </form>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#key-@d.Id" title="مفتاح الربط"><i class="bi bi-key"></i></button>
                                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary" title="تعديل"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        data-delete-url="@Url.Action("Delete", new { id = d.Id })" data-delete-name="@d.Name"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                        <tr class="collapse" id="key-@d.Id">
                            <td colspan="5" class="small">
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="text-muted">مفتاح الربط (للبرنامج اللي في الشركة):</span>
                                    <code dir="ltr" class="user-select-all">@d.ApiKey</code>
                                    <form asp-action="NewKey" asp-route-id="@d.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('المفتاح القديم هيبطل يشتغل. متأكد؟')">
                                        <button type="submit" class="btn btn-sm btn-link p-0">مفتاح جديد</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="page-card">
    <h2 class="h6 fw-bold mb-3"><i class="bi bi-info-circle"></i> قبل ما تبدأ</h2>
    <ol class="small mb-0">
        <li class="mb-1">في ملف كل موظف (تعديل ← الوظيفة) اكتب <strong>رقم البصمة</strong>: نفس الرقم اللي الموظف متسجل بيه على الجهاز.</li>
        <li class="mb-1">لو البرنامج على الإنترنت: شغّل <strong>برنامج ربط البصمة</strong> على أي كمبيوتر في الشركة على نفس شبكة الجهاز، وحط فيه:
            عنوان الموقع <code dir="ltr">@site</code> ومفتاح الربط بتاع الجهاز (زرار <i class="bi bi-key"></i>) والـ IP بتاعه.</li>
        <li>الأيام اللي الـ HR عدّلها بإيده مش بتتغير من البصمة.</li>
    </ol>
</div>