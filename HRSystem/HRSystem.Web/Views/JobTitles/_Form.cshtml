@model SaveJobTitleDto

<div class="page-card" style="max-width: 640px">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <label asp-for="MinSalary" class="form-label"></label>
                <input asp-for="MinSalary" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MinSalary" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="MaxSalary" class="form-label"></label>
                <input asp-for="MaxSalary" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MaxSalary" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
        <a asp-action="Index" class="btn btn-light">إلغاء</a>
    </form>
</div>
