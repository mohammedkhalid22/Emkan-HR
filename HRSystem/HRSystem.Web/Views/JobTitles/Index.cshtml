@model List<JobTitleDto>
@{
    ViewData["Title"] = "المسميات الوظيفية";
    var canEdit = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.HR);
}

<div class="page-card">
    <div class="page-toolbar">
        <span class="text-muted">@Model.Count مسمى</span>
        @if (canEdit)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة مسمى</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-briefcase"></i>
            لسه مفيش مسميات وظيفية
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>المسمى</th>
                        <th>نطاق المرتب (جنيه)</th>
                        <th>عدد الموظفين</th>
                        @if (canEdit) { <th class="text-end">إجراءات</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jobTitle in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@jobTitle.Name</td>
                            <td>
                                @if (jobTitle.MinSalary is null && jobTitle.MaxSalary is null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span>@(jobTitle.MinSalary?.ToString("N0") ?? "—") إلى @(jobTitle.MaxSalary?.ToString("N0") ?? "—")</span>
                                }
                            </td>
                            <td>@jobTitle.EmployeesCount</td>
                            @if (canEdit)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@jobTitle.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                            data-delete-url="@Url.Action("Delete", new { id = jobTitle.Id })"
                                            data-delete-name="@jobTitle.Name">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
