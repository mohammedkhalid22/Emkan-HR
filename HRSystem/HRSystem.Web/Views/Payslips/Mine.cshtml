@model List<MyPayslipDto>
@{
    ViewData["Title"] = "كشوف مرتباتي";
}

<div class="page-card" style="max-width: 760px">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-receipt"></i> لسه مفيش كشوف مرتبات معتمدة</div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>الشهر</th><th>الإجمالي</th><th>الصافي</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@Labels.Month(p.Year, p.Month)</td>
                        <td>@Labels.Money(p.GrossSalary)</td>
                        <td class="fw-bold">@Labels.Money(p.NetSalary)</td>
                        <td class="text-end"><a asp-action="Download" asp-route-id="@p.ItemId" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-pdf"></i> PDF</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
