@model List<HRSystem.Web.Services.DataImport.DataImporter.BatchDto>
@{
    ViewData["Title"] = "استيراد البيانات الأساسية";
}

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="page-card h-100">
            <h2 class="h6 fw-bold mb-2"><span class="badge text-bg-primary me-1">1</span> نزّل القالب واملاه</h2>
            <p class="small text-muted">ملف Excel فيه شيت لكل شاشة: الفروع، الإدارات والأقسام، المسميات، الورديات، المواقع الوظيفية، أنواع الإجازات، العطلات، مكونات المرتب، والموظفين.
                الأعمدة الحمرا مطلوبة، وفيه قوائم اختيار جاهزة. املا اللي عندك بس.</p>
            <a asp-action="Template" class="btn btn-outline-primary"><i class="bi bi-file-earmark-excel"></i> تنزيل القالب</a>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="page-card h-100">
            <h2 class="h6 fw-bold mb-2"><span class="badge text-bg-primary me-1">2</span> ارفع الملف</h2>
            <p class="small text-muted">القالب، أو <strong>أي ملف Excel عندك</strong> بأعمدته وأسمائه: الذكاء الاصطناعي بيربط كل شيت وعمود بمكانه في البرنامج وإنت بتراجع.
                مفيش حاجة بتتحفظ قبل ما تشوف المعاينة وتختار الصفوف.</p>
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2" data-busy="بنراجع الملف...">
                <input type="file" name="file" accept=".xlsx" class="form-control" required />
                <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-upload"></i> رفع ومعاينة</button>
            </form>
        </div>
    </div>
</div>

<div class="page-card">
    <h2 class="h6 fw-bold mb-3">الاستيرادات اللي فاتت</h2>
    @if (Model.Count == 0)
    {
        <div class="text-muted small">لسه مفيش</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>إمتى</th><th>الملف</th><th>مين</th><th>النتيجة</th><th class="text-end"></th></tr></thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="small text-nowrap">@b.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="small" dir="ltr" style="text-align: right">@b.FileName</td>
                            <td class="small">@(b.By ?? "—")</td>
                            <td class="small">@b.Summary @if (b.UndoneAt is DateTime u) { <span class="badge text-bg-secondary">اتلغى @u.ToLocalTime().ToString("yyyy-MM-dd")</span> }</td>
                            <td class="text-end">
                                @if (b.UndoneAt is null && b.CreatedCount > 0)
                                {
                                    <form asp-action="Undo" asp-route-id="@b.Id" method="post"
                                          onsubmit="return confirm('هيتشال كل اللي الاستيراد ده عمله جديد (@b.CreatedCount سجل). التحديثات على سجلات قديمة مش بترجع. متأكد؟')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-counterclockwise"></i> تراجع</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>