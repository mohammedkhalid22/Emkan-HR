@using HRSystem.Web.Services.DataImport
@model HRSystem.Web.Controllers.DataImportMappingModel
@{
    ViewData["Title"] = "ربط أعمدة الملف";
    var m = Model.Mapping;
}

<form asp-action="Map" method="post" id="mapForm">
    <input type="hidden" name="Token" value="@Model.Token" />
    <input type="hidden" name="FileName" value="@Model.FileName" />

    <div class="page-card mb-3">
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <div class="flex-grow-1">
                <div class="fw-bold" dir="ltr" style="text-align: right">@Model.FileName</div>
                <div class="small text-muted">الملف مش على شكل القالب، فاتربط كل شيت وكل عمود بالشاشة والخانة اللي تقابله. راجع الربط وغيّر أي حاجة، وبعدين معاينة.</div>
            </div>
            <a asp-action="Index" class="btn btn-light">إلغاء</a>
            <button type="submit" class="btn btn-primary" data-busy="بنجهز المعاينة..."><i class="bi bi-eye"></i> معاينة</button>
        </div>
        @if (m.AiNote is not null)
        {
            <div class="alert @(m.AiNote.StartsWith("الذكاء الاصطناعي ربط") ? "alert-info" : "alert-warning") small py-2 mt-3 mb-0"><i class="bi bi-stars"></i> @m.AiNote</div>
        }
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" name="CreateMissing" value="true" id="CreateMissing" checked="@m.CreateMissing" />
            <label class="form-check-label" for="CreateMissing">الأقسام والمسميات المكتوبة للموظفين ومش موجودة، اعملها تلقائي</label>
            <div class="form-text">الأقسام بتتعمل كإدارات، وتقدر تنظمها في الشجرة بعدين.</div>
        </div>
    </div>

    @for (var i = 0; i < Model.Raw.Count; i++)
    {
        var sheet = Model.Raw[i];
        var map = m.Sheets.FirstOrDefault(s => s.Source == sheet.Name) ?? new SheetMapping { Source = sheet.Name };
        var target = map.Target is null ? null : ImportSheets.Find(map.Target);
        <div class="page-card mb-3 map-sheet">
            <input type="hidden" name="Sheets[@i].Source" value="@sheet.Name" />
            <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
                <div>
                    <div class="small text-muted">الشيت في الملف</div>
                    <div class="fw-bold">@sheet.Name <span class="badge text-bg-light">@sheet.Rows.Count صف</span></div>
                </div>
                <i class="bi bi-arrow-left fs-4 text-muted"></i>
                <div style="min-width: 240px">
                    <label class="small text-muted">يتحفظ في شاشة</label>
                    <select name="Sheets[@i].Target" class="form-select sheet-target">
                        <option value="">— تجاهل الشيت ده —</option>
                        @foreach (var t in ImportSheets.All)
                        {
                            <option value="@t.Key" selected="@(t.Key == map.Target)">@t.Name</option>
                        }
                    </select>
                </div>
                @if (target is not null)
                {
                    var missing = target.Columns.Where(c => c.Required && !map.Columns.ContainsValue(c.Key)).Select(c => c.Header).ToList();
                    if (missing.Count > 0)
                    {
                        <div class="small text-danger">ناقص: @string.Join("، ", missing)</div>
                    }
                }
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>العمود في الملف</th><th>أمثلة</th><th style="width: 260px">الخانة في البرنامج</th></tr></thead>
                    <tbody>
                        @for (var j = 0; j < sheet.Columns.Count; j++)
                        {
                            var col = sheet.Columns[j];
                            var current = map.Columns.GetValueOrDefault(col.Header);
                            <tr>
                                <td class="fw-semibold">@col.Header<input type="hidden" name="Sheets[@i].Columns[@j].Header" value="@col.Header" /></td>
                                <td class="small text-muted">@string.Join(" · ", col.Samples)</td>
                                <td>
                                    <select name="Sheets[@i].Columns[@j].Target" class="form-select form-select-sm column-target @(current is null ? "" : "border-primary")">
                                        <option value="">— مش مطلوب —</option>
                                        @foreach (var t in ImportSheets.All)
                                        {
                                            foreach (var c in t.Columns)
                                            {
                                                <option value="@c.Key" data-sheet="@t.Key" selected="@(t.Key == map.Target && c.Key == current)">@c.Header@(c.Required ? " *" : "")</option>
                                            }
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                var k = 0;
                var valueColumns = target?.Columns.Where(c => c.Options is not null && map.Columns.ContainsValue(c.Key)).ToList() ?? [];
            }
            @foreach (var vc in valueColumns)
            {
                var header = map.Columns.First(x => x.Value == vc.Key).Key;
                var raw = sheet.Columns.First(c => c.Header == header);
                if (raw.Distinct.Count == 0) { continue; }
                <div class="mt-3">
                    <div class="small fw-semibold mb-1">قيم «@header» ← @vc.Header</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var value in raw.Distinct)
                        {
                            var picked = map.Values.GetValueOrDefault(vc.Key)?.GetValueOrDefault(value);
                            <div class="input-group input-group-sm" style="width: auto">
                                <span class="input-group-text">@value</span>
                                <input type="hidden" name="Sheets[@i].Values[@k].Column" value="@vc.Key" />
                                <input type="hidden" name="Sheets[@i].Values[@k].Source" value="@value" />
                                <select name="Sheets[@i].Values[@k].Target" class="form-select @(picked is null ? "border-warning" : "")">
                                    <option value="">— زي ما هي —</option>
                                    @foreach (var o in vc.Options!)
                                    {
                                        <option selected="@(o == picked)">@o</option>
                                    }
                                </select>
                            </div>
                            k++;
                        }
                    </div>
                </div>
            }
        </div>
    }
</form>

@section Scripts {
    <script>
        // A column can only map to a field of the screen its sheet goes to
        document.querySelectorAll('.map-sheet').forEach(card => {
            const sheetSelect = card.querySelector('.sheet-target');
            function apply() {
                const target = sheetSelect.value;
                card.querySelectorAll('.column-target').forEach(select => {
                    select.disabled = !target;
                    select.querySelectorAll('option[data-sheet]').forEach(o => {
                        const show = o.dataset.sheet === target;
                        o.hidden = !show;
                        if (!show && o.selected) select.value = '';
                    });
                });
            }
            sheetSelect.addEventListener('change', apply);
            apply();
        });
    </script>
}