@using HRSystem.BLL.Services
@model HRSystem.BLL.Common.PagedResult<NotificationDto>
@{
    ViewData["Title"] = "الإشعارات";
    var pages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
}

<div class="page-card" style="max-width: 860px">
    <div class="page-toolbar">
        <span class="text-muted">@Model.TotalCount إشعار</span>
        @if (Model.Items.Any(n => !n.IsRead))
        {
            <form asp-action="ReadAll" method="post">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-check2-all"></i> علّم الكل كمقروء</button>
            </form>
        }
    </div>

    <div class="notif-page">
        <partial name="_List" model="Model.Items" />
    </div>

    @if (pages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                @for (var p = 1; p <= pages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@p">@p</a></li>
                }
            </ul>
        </nav>
    }
</div>
