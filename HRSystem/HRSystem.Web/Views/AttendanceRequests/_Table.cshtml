@model (List<AttendanceRequestDto> Items, bool ShowEmployee)
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state"><i class="bi bi-clock"></i> مفيش طلبات</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    @if (Model.ShowEmployee) { <th>الموظف</th> }
                    <th>النوع</th><th>التاريخ</th><th>من</th><th>إلى</th><th>السبب</th><th>الحالة</th>
                    <th class="text-end">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        @if (Model.ShowEmployee)
                        {
                            <td><span class="fw-semibold">@r.EmployeeName</span><div class="small text-muted">@r.DepartmentName</div></td>
                        }
                        <td>@Labels.Of(r.Type)</td>
                        <td class="text-nowrap">@r.Date.ToString("yyyy-MM-dd")</td>
                        <td>@Labels.Time(r.FromTime)</td>
                        <td>@Labels.Time(r.ToTime)</td>
                        <td class="small">@r.Reason</td>
                        <td>
                            <span class="badge @Labels.StatusBadge(r.Status)">@Labels.Of(r)</span>
                            @if (r.RejectionReason is not null) { <div class="small text-danger mt-1">@r.RejectionReason</div> }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (r.CanApprove)
                            {
                                <form asp-controller="AttendanceRequests" asp-action="Approve" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> موافقة</button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-reject-url="@Url.Action("Reject", "AttendanceRequests", new { id = r.Id })" data-reject-name="@r.EmployeeName">
                                    <i class="bi bi-x-lg"></i> رفض
                                </button>
                            }
                            @if (r.CanCancel)
                            {
                                <form asp-controller="AttendanceRequests" asp-action="Cancel" asp-route-id="@r.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('متأكد إنك عايز تلغي الطلب؟')">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">إلغاء الطلب</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
