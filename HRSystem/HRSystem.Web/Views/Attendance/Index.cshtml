@model AttendanceIndexViewModel
@{
    ViewData["Title"] = Model.ShowEmployee ? "سجل الحضور" : "حضوري";
    var f = Model.Filter;
    var result = Model.Result;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@* Where the employee checked in/out from the app: red when outside the branch radius (remote staff) *@
@functions {
    private static string Coord(double value) => value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
}
@{
    void GeoPin(double? lat, double? lng, int? distance, int? radius)
    {
        if (lat is not double la || lng is not double lo)
            return;

        var outside = distance is int d && radius is int r && d > r;
        var title = distance is int m ? $"على بعد {m} متر من الفرع" : "مكان التسجيل";
        <a href="https://www.google.com/maps?q=@Coord(la),@Coord(lo)" target="_blank" rel="noopener"
           class="text-decoration-none @(outside ? "text-danger" : "text-success")" title="@title">
            <i class="bi bi-geo-alt-fill"></i>@if (outside) { <small>@distance م</small> }
        </a>
    }

    // Opens the selfie in the dialog at the bottom of the page
    void SelfieLink(AttendanceRecordDto record, string which, bool has)
    {
        if (!has)
            return;
        <a href="@Url.Action("Selfie", new { id = record.Id, which })" class="text-decoration-none text-primary" title="صورة السيلفي"
           data-selfie-url="@Url.Action("Selfie", new { id = record.Id, which })"
           data-selfie-title="@record.EmployeeName · @(which == "in" ? "حضور" : "انصراف") @record.Date.ToString("yyyy-MM-dd") @Labels.Time(which == "in" ? record.CheckIn : record.CheckOut)">
            <i class="bi bi-camera-fill"></i>
        </a>
    }
}

@if (Model.Today is not null)
{
    <partial name="_CheckInCard" model="Model.Today" />
}

<div class="page-card">
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-2">
            <label class="form-label small text-muted" for="From">من</label>
            <input type="date" name="From" id="From" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted" for="To">إلى</label>
            <input type="date" name="To" id="To" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        @if (Model.ShowEmployee)
        {
            <div class="col-md-2">
                <label class="form-label small text-muted" for="Search">بحث</label>
                <input name="Search" id="Search" value="@f.Search" class="form-control" placeholder="الاسم أو الكود" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted" for="DepartmentId">القسم</label>
                <select name="DepartmentId" id="DepartmentId" asp-items="Model.Departments" class="form-select"><option value="">الكل</option></select>
            </div>
        }
        <div class="col-md-2">
            <label class="form-label small text-muted" for="Status">الحالة</label>
            <select name="Status" id="Status" class="form-select">
                <option value="">الكل</option>
                @foreach (var s in Enum.GetValues<AttendanceStatus>())
                {
                    <option value="@s" selected="@(f.Status == s)">@Labels.Of(s)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> عرض</button>
        </div>
    </form>

    <div class="page-toolbar">
        <span class="text-muted">@result.TotalCount تسجيل</span>
        @if (Model.CanEdit)
        {
            <form asp-action="CloseDays" method="post" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="from" value="@f.From?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="to" value="@f.To?.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-outline-secondary btn-sm" title="يسجل الغياب والإجازات والعطلات للأيام اللي فاتت في الفترة دي">
                    <i class="bi bi-calendar-check"></i> إقفال الأيام
                </button>
            </form>
        }
    </div>

    @if (result.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-clock-history"></i> مفيش تسجيلات في الفترة دي</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        @if (Model.ShowEmployee) { <th>الموظف</th> }
                        <th>التاريخ</th>
                        <th>الحالة</th>
                        <th>حضور</th>
                        <th>انصراف</th>
                        <th>تأخير</th>
                        <th>انصراف مبكر</th>
                        <th>أوفر تايم</th>
                        <th>المصدر</th>
                        @if (Model.CanEdit) { <th class="text-end">تعديل</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in result.Items)
                    {
                        <tr>
                            @if (Model.ShowEmployee)
                            {
                                <td><span class="fw-semibold">@r.EmployeeName</span><div class="small text-muted">@r.DepartmentName</div></td>
                            }
                            <td class="text-nowrap">@r.Date.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge @Labels.StatusBadge(r.Status)">@Labels.Of(r.Status)</span></td>
                            <td class="text-nowrap">@Labels.Time(r.CheckIn) @{ GeoPin(r.CheckInLatitude, r.CheckInLongitude, r.CheckInDistanceMeters, r.BranchRadiusMeters); SelfieLink(r, "in", r.HasCheckInPhoto); }</td>
                            <td class="text-nowrap">@Labels.Time(r.CheckOut) @{ GeoPin(r.CheckOutLatitude, r.CheckOutLongitude, r.CheckOutDistanceMeters, r.BranchRadiusMeters); SelfieLink(r, "out", r.HasCheckOutPhoto); }</td>
                            <td class="@(r.LateMinutes > 0 ? "text-danger fw-semibold" : "")">@Labels.Minutes(r.LateMinutes)</td>
                            <td class="@(r.EarlyLeaveMinutes > 0 ? "text-danger" : "")">@Labels.Minutes(r.EarlyLeaveMinutes)</td>
                            <td class="@(r.OvertimeMinutes > 0 ? "text-success fw-semibold" : "")">@Labels.Minutes(r.OvertimeMinutes)</td>
                            <td class="small text-muted" title="@r.Notes">@Labels.Of(r.Source)@(r.Notes is null ? "" : " *")</td>
                            @if (Model.CanEdit)
                            {
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-employeeId="@r.EmployeeId" asp-route-date="@r.Date.ToString("yyyy-MM-dd")" asp-route-returnUrl="@returnUrl"
                                       class="btn btn-sm btn-outline-primary" title="تعديل"><i class="bi bi-pencil"></i></a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (result.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="الصفحات">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(result.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-route-From="@f.From?.ToString("yyyy-MM-dd")" asp-route-To="@f.To?.ToString("yyyy-MM-dd")" asp-route-Search="@f.Search" asp-route-DepartmentId="@f.DepartmentId" asp-route-Status="@f.Status" asp-route-Page="@(result.Page - 1)">السابق</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">صفحة @result.Page من @result.TotalPages</span></li>
                    <li class="page-item @(result.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-route-From="@f.From?.ToString("yyyy-MM-dd")" asp-route-To="@f.To?.ToString("yyyy-MM-dd")" asp-route-Search="@f.Search" asp-route-DepartmentId="@f.DepartmentId" asp-route-Status="@f.Status" asp-route-Page="@(result.Page + 1)">التالي</a>
                    </li>
                </ul>
            </nav>
        }
    }
    <p class="small text-muted mt-3 mb-0">
        الغياب والإجازات والعطلات بتتسجل لوحدها كل كام ساعة للأيام اللي فاتت. التأخير والانصراف المبكر والأوفر تايم بالساعة:الدقيقة.
        * = متعدل يدويًا (حط الماوس على المصدر عشان تشوف السبب).
    </p>
</div>

<div class="modal fade" id="selfieModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title fs-6" id="selfieTitle"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body p-2 text-center">
                <img id="selfieImage" alt="صورة السيلفي" class="img-fluid rounded" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            const link = e.target.closest('[data-selfie-url]');
            if (!link) return;
            e.preventDefault();
            document.getElementById('selfieImage').src = link.dataset.selfieUrl;
            document.getElementById('selfieTitle').textContent = link.dataset.selfieTitle;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('selfieModal')).show();
        });
    </script>
}
