@model EmployeeFormViewModel

@* The action is explicit: after "fill from CV" the page is served from another URL *@
<form method="post" enctype="multipart/form-data" id="employeeForm"
      asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CandidateId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="page-card">
        @if (Model.Code is not null)
        {
            <p class="text-muted mb-3">كود الموظف: <span dir="ltr" class="fw-semibold">@Model.Code</span></p>
        }

        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-personal" type="button" role="tab">
                    <i class="bi bi-person"></i> البيانات الشخصية
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-job" type="button" role="tab">
                    <i class="bi bi-briefcase"></i> الوظيفة
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-finance" type="button" role="tab">
                    <i class="bi bi-cash"></i> المالية والبنك
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-official" type="button" role="tab">
                    <i class="bi bi-card-checklist"></i> بيانات رسمية
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-home" type="button" role="tab">
                    <i class="bi bi-house-heart"></i> السكن والطوارئ
                </button>
            </li>
        </ul>

        <div class="tab-content">
            @* ---------- Personal ---------- *@
            <div class="tab-pane fade show active" id="tab-personal" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullNameAr" class="form-label"></label>
                        <input asp-for="FullNameAr" class="form-control" />
                        <span asp-validation-for="FullNameAr" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FullNameEn" class="form-label"></label>
                        <input asp-for="FullNameEn" class="form-control" dir="ltr" />
                        <span asp-validation-for="FullNameEn" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NationalId" class="form-label"></label>
                        <input asp-for="NationalId" class="form-control" dir="ltr" maxlength="14" inputmode="numeric" />
                        <div class="form-text">تاريخ الميلاد والنوع بيتملوا لوحدهم من الرقم القومي.</div>
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BirthDate" class="form-label"></label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" asp-items="Labels.Options<Gender>(Labels.Of)" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MaritalStatus" class="form-label"></label>
                        <select asp-for="MaritalStatus" asp-items="Labels.Options<MaritalStatus>(Labels.Of)" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" dir="ltr" inputmode="tel" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" dir="ltr" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Photo" class="form-label"></label>
                        <input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
                        <div class="form-text">
                            JPG أو PNG، أقصى حجم 5 ميجا.
                            @if (Model.HasPhoto) { <span>اختار صورة جديدة لو عايز تغيرها.</span> }
                        </div>
                        <span asp-validation-for="Photo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @* ---------- Job ---------- *@
            <div class="tab-pane fade" id="tab-job" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="PositionId" class="form-label"></label>
                        <select asp-for="PositionId" class="form-select">
                            <option value="">— بدون (القسم والمسمى والمدير يدوي) —</option>
                            @foreach (var group in Model.Positions.GroupBy(p => p.DepartmentName))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var p in group)
                                    {
                                        <option value="@p.Id" data-dept="@p.DepartmentId" data-job="@p.JobTitleId">@p.Name (@p.Holders من @p.Capacity)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <div class="form-text" id="position-note">لما تختار موقع: القسم والمسمى بيتملوا منه، والمدير المباشر بيتحدد لوحده من الشجرة التنظيمية.</div>
                        <span asp-validation-for="PositionId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FingerprintId" class="form-label"></label>
                        <input asp-for="FingerprintId" class="form-control" dir="ltr" inputmode="numeric" />
                        <div class="form-text">رقم الموظف على جهاز البصمة.</div>
                        <span asp-validation-for="FingerprintId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label"></label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="JobTitleId" class="form-label"></label>
                        <select asp-for="JobTitleId" asp-items="Model.JobTitles" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                        <span asp-validation-for="JobTitleId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6" id="manager-field">
                        <label asp-for="ManagerId" class="form-label"></label>
                        <select asp-for="ManagerId" asp-items="Model.Managers" class="form-select">
                            <option value="">— بدون —</option>
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ShiftId" class="form-label"></label>
                        <select asp-for="ShiftId" asp-items="Model.Shifts" class="form-select">
                            <option value="">— بدون —</option>
                        </select>
                        <span asp-validation-for="ShiftId" class="text-danger"></span>
                        <div class="form-check mt-2">
                            <input asp-for="AllowRemoteAttendance" class="form-check-input" />
                            <label asp-for="AllowRemoteAttendance" class="form-check-label"></label>
                        </div>
                        <div class="form-text">للمناديب وشغل البيت. مكانه هيتسجل برضه.</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="HireDate" class="form-label"></label>
                        <input asp-for="HireDate" type="date" class="form-control" />
                        <span asp-validation-for="HireDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContractType" class="form-label"></label>
                        <select asp-for="ContractType" asp-items="Labels.Options<ContractType>(Labels.Of)" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                        <span asp-validation-for="ContractType" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContractEndDate" class="form-label"></label>
                        <input asp-for="ContractEndDate" type="date" class="form-control" />
                        <div class="form-text">مطلوب للعقد المؤقت.</div>
                        <span asp-validation-for="ContractEndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @* ---------- Financial ---------- *@
            <div class="tab-pane fade" id="tab-finance" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="BasicSalary" class="form-label"></label>
                        <input asp-for="BasicSalary" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="BasicSalary" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InsuranceSalary" class="form-label"></label>
                        <input asp-for="InsuranceSalary" type="number" step="0.01" min="0" class="form-control" />
                        <div class="form-text">لو سبته فاضي هياخد نفس المرتب الأساسي.</div>
                        <span asp-validation-for="InsuranceSalary" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BankName" class="form-label"></label>
                        <input asp-for="BankName" class="form-control" placeholder="مثلًا: البنك الأهلي المصري" />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BankBranch" class="form-label"></label>
                        <input asp-for="BankBranch" class="form-control" />
                        <span asp-validation-for="BankBranch" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BankAccount" class="form-label"></label>
                        <input asp-for="BankAccount" class="form-control" dir="ltr" />
                        <span asp-validation-for="BankAccount" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Iban" class="form-label"></label>
                        <input asp-for="Iban" class="form-control" dir="ltr" placeholder="EG..." />
                        <span asp-validation-for="Iban" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @* ---------- Official ---------- *@
            <div class="tab-pane fade" id="tab-official" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Nationality" class="form-label"></label>
                        <input asp-for="Nationality" class="form-control" placeholder="مصري" />
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Religion" class="form-label"></label>
                        <select asp-for="Religion" asp-items="Labels.Options<Religion>(Labels.Of)" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MilitaryStatus" class="form-label"></label>
                        <select asp-for="MilitaryStatus" asp-items="Labels.Options<MilitaryStatus>(Labels.Of)" class="form-select">
                            <option value="">— اختار —</option>
                        </select>
                        <div class="form-text">للرجالة بس.</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InsuranceNumber" class="form-label"></label>
                        <input asp-for="InsuranceNumber" class="form-control" dir="ltr" inputmode="numeric" />
                        <span asp-validation-for="InsuranceNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InsuranceStartDate" class="form-label"></label>
                        <input asp-for="InsuranceStartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BloodType" class="form-label"></label>
                        <select asp-for="BloodType" class="form-select" dir="ltr">
                            <option value="">—</option>
                            @foreach (var b in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                        <span asp-validation-for="BloodType" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PassportNumber" class="form-label"></label>
                        <input asp-for="PassportNumber" class="form-control" dir="ltr" />
                        <span asp-validation-for="PassportNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PassportExpiry" class="form-label"></label>
                        <input asp-for="PassportExpiry" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4 d-none d-md-block"></div>
                    <div class="col-md-4">
                        <label asp-for="DrivingLicenseNumber" class="form-label"></label>
                        <input asp-for="DrivingLicenseNumber" class="form-control" dir="ltr" />
                        <span asp-validation-for="DrivingLicenseNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DrivingLicenseExpiry" class="form-label"></label>
                        <input asp-for="DrivingLicenseExpiry" type="date" class="form-control" />
                    </div>
                </div>
            </div>

            @* ---------- Home and emergency ---------- *@
            <div class="tab-pane fade" id="tab-home" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Governorate" class="form-label"></label>
                        <input asp-for="Governorate" class="form-control" list="governorates" />
                        <datalist id="governorates">
                            @foreach (var g in new[] { "القاهرة", "الجيزة", "الإسكندرية", "القليوبية", "الشرقية", "الدقهلية", "الغربية", "المنوفية", "البحيرة", "كفر الشيخ", "دمياط", "بورسعيد", "الإسماعيلية", "السويس", "الفيوم", "بني سويف", "المنيا", "أسيوط", "سوهاج", "قنا", "الأقصر", "أسوان", "البحر الأحمر", "الوادي الجديد", "مطروح", "شمال سيناء", "جنوب سيناء" })
                            {
                                <option value="@g"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Governorate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="col-12"><hr class="my-1" /><div class="fw-semibold small text-muted">في حالة الطوارئ نكلم مين؟</div></div>
                    <div class="col-md-4">
                        <label asp-for="EmergencyContactName" class="form-label"></label>
                        <input asp-for="EmergencyContactName" class="form-control" />
                        <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EmergencyContactRelation" class="form-label"></label>
                        <input asp-for="EmergencyContactRelation" class="form-control" placeholder="أخ، زوجة، والد..." />
                        <span asp-validation-for="EmergencyContactRelation" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EmergencyContactPhone" class="form-label"></label>
                        <input asp-for="EmergencyContactPhone" class="form-control" dir="ltr" inputmode="tel" />
                        <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
                    </div>
                    <div class="col-12 form-text">الأسرة والمؤهلات والخبرات بتتضاف من ملف الموظف بعد الحفظ.</div>
                </div>
            </div>
        </div>

        <hr />
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
        <a asp-action="@(Model.Id == 0 ? "Index" : "Details")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" class="btn btn-light">إلغاء</a>
    </div>
</form>
