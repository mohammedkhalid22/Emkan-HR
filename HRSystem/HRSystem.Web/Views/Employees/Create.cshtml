@model EmployeeFormViewModel
@{
    ViewData["Title"] = "إضافة موظف";
}

@* Fill the form from a CV with the AI; nothing is saved until the form itself is submitted *@
<div class="page-card cv-fill mb-3">
    <form asp-action="FillFromCv" method="post" enctype="multipart/form-data"
          class="d-flex flex-wrap align-items-end gap-2" data-busy="بيقرا الـ CV...">
        <div class="flex-grow-1">
            <label for="cvFile" class="form-label fw-semibold mb-1"><i class="bi bi-stars text-primary"></i> عندك الـ CV؟ ارفعه والذكاء الاصطناعي يملالك البيانات</label>
            <input type="file" name="cvFile" id="cvFile" accept=".pdf,.jpg,.jpeg,.png" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-magic"></i> املأ من الـ CV</button>
    </form>
</div>

@if (ViewData["CvNote"] is string note)
{
    <div class="alert alert-info"><i class="bi bi-stars"></i> @note</div>
}

<partial name="_Form" model="Model" />

@section Scripts {
    <partial name="_FormScripts" />
}
