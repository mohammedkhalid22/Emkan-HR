@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "نسيت كلمة السر";
    Layout = "_AuthLayout";
    var emailEnabled = ViewData["EmailEnabled"] is true;
}

<div class="auth-greeting">
    <h2>نسيت كلمة السر؟</h2>
    <p>اكتب إيميلك وهنبعتلك لينك تعمل بيه كلمة سر جديدة</p>
</div>

@if (!emailEnabled)
{
    <div class="alert alert-warning small">
        <i class="bi bi-envelope-slash"></i> إرسال الإيميلات مش متفعّل على السيرفر ده. كلّم مدير النظام يغيّرلك كلمة السر من شاشة المستخدمين.
    </div>
}
else if (ViewData["Sent"] is true)
{
    <div class="alert alert-success small">
        <i class="bi bi-envelope-check"></i> لو الإيميل ده متسجل عندنا، هيوصلك لينك خلال دقايق. شوف الـ Spam لو مالقيتوش. اللينك شغال ساعتين.
    </div>
}
else
{
    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <div class="auth-field">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" class="form-control" dir="ltr" autocomplete="username" placeholder="name@company.com" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn auth-submit w-100">ابعتلي اللينك <i class="bi bi-arrow-left"></i></button>
    </form>
}

<p class="auth-note"><a asp-action="Login">رجوع لتسجيل الدخول</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
