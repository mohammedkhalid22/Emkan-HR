@model ResetPasswordViewModel
@{
    ViewData["Title"] = "كلمة سر جديدة";
    Layout = "_AuthLayout";
}

<div class="auth-greeting">
    <h2>كلمة سر جديدة</h2>
    <p dir="ltr" class="text-end">@Model.Email</p>
</div>

<form asp-action="ResetPassword" method="post" novalidate>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="auth-field">
            <i class="bi bi-lock"></i>
            <input asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" autofocus />
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="auth-field">
            <i class="bi bi-lock"></i>
            <input asp-for="ConfirmPassword" class="form-control" dir="ltr" autocomplete="new-password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn auth-submit w-100">احفظ كلمة السر <i class="bi bi-arrow-left"></i></button>
</form>

<p class="auth-note">8 حروف على الأقل، وفيها حرف كبير وصغير ورقم.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
