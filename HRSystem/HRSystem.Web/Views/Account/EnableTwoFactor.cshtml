@model TwoFactorSetupViewModel
@{
    ViewData["Title"] = "تفعيل التحقق بخطوتين";
}

<div class="page-card" style="max-width: 760px">
    <ol class="tfa-steps">
        <li>
            <h3 class="h6 fw-bold">نزّل تطبيق تحقق على موبايلك</h3>
            <p class="text-muted small mb-0">Google Authenticator أو Microsoft Authenticator، من Play Store أو App Store.</p>
        </li>
        <li>
            <h3 class="h6 fw-bold">امسح الكود ده من التطبيق</h3>
            <div class="d-flex flex-wrap align-items-center gap-4">
                <div id="qrCode" class="tfa-qr" data-uri="@Model.AuthenticatorUri"></div>
                <div class="small text-muted">
                    مش قادر تمسح؟ اختار "إدخال مفتاح" في التطبيق واكتب:
                    <div class="tfa-key ltr-value">@Model.SharedKey</div>
                </div>
            </div>
        </li>
        <li>
            <h3 class="h6 fw-bold">اكتب الكود اللي ظهر في التطبيق</h3>
            <form asp-action="EnableTwoFactor" method="post" class="row g-2 align-items-start" style="max-width: 420px">
                <div class="col">
                    <input asp-for="Code" class="form-control otp-input" dir="ltr" autocomplete="one-time-code" inputmode="numeric" placeholder="123456" autofocus />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> فعّل</button>
                </div>
            </form>
        </li>
    </ol>
    <a asp-action="Security" class="btn btn-light mt-2">إلغاء</a>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        const box = document.getElementById('qrCode');
        if (window.QRCode) new QRCode(box, { text: box.dataset.uri, width: 180, height: 180, correctLevel: QRCode.CorrectLevel.M });
        else box.textContent = 'الكود مش ظاهر؟ استخدم المفتاح المكتوب جنبه';
    </script>
    <partial name="_ValidationScriptsPartial" />
}
