@model SaveSalaryComponentDto

<div class="page-card" style="max-width: 640px">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="Labels.Options<SalaryComponentType>(Labels.Of)" class="form-select"></select>
            </div>
            <div class="col-sm-6">
                <label asp-for="CalcMethod" class="form-label"></label>
                <select asp-for="CalcMethod" asp-items="Labels.Options<CalculationMethod>(Labels.Of)" class="form-select"></select>
            </div>
        </div>
        <div class="form-check mb-4">
            <input asp-for="IsTaxable" class="form-check-input" />
            <label asp-for="IsTaxable" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
        <a asp-action="Index" class="btn btn-light">إلغاء</a>
    </form>
</div>
