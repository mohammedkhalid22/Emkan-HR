@model SaveShiftDto

<div class="page-card" style="max-width: 640px">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="GraceMinutes" class="form-label"></label>
                <input asp-for="GraceMinutes" type="number" min="0" max="120" class="form-control" />
                <span asp-validation-for="GraceMinutes" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
        <a asp-action="Index" class="btn btn-light">إلغاء</a>
    </form>
</div>
