@model List<BranchDto>
@{
    ViewData["Title"] = "الفروع";
    var canEdit = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.HR);
}

<div class="page-card">
    <div class="page-toolbar">
        <span class="text-muted">@Model.Count فرع</span>
        @if (canEdit)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة فرع</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-building"></i>
            لسه مفيش فروع
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>اسم الفرع</th>
                        <th>العنوان</th>
                        <th>عدد الأقسام</th>
                        @if (canEdit) { <th class="text-end">إجراءات</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@branch.Name</td>
                            <td>@(branch.Address ?? "—")</td>
                            <td>@branch.DepartmentsCount</td>
                            @if (canEdit)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                            data-delete-url="@Url.Action("Delete", new { id = branch.Id })"
                                            data-delete-name="@branch.Name">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
